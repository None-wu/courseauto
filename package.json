{
  "name": "courseauto",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "description": "刷课助手:学习通/智慧树/雨课堂三平台油猴脚本(内核 + 适配层) + 本机安装向导 / 网页 AI 中转 + 单文件 exe 打包 + 端到端沙箱",
  "keywords": [
    "userscript",
    "tampermonkey",
    "chaoxing",
    "xuexitong",
    "zhihuishu",
    "yuketang",
    "greasemonkey"
  ],
  "license": "MIT",
  "author": "courseauto contributors",
  "homepage": "https://github.com/None-wu/courseauto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/None-wu/courseauto.git"
  },
  "bugs": {
    "url": "https://github.com/None-wu/courseauto/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "pack": "node tools/pack.mjs",
    "setup": "node local/setup.mjs",
    "app": "node local/app.mjs",
    "detect": "node local/detect.mjs",
    "mock": "node local/server.mjs",
    "test": "npm --prefix extras/tests test",
    "test:webai": "npm --prefix extras/tests run test:webai",
    "test:quiz": "npm --prefix extras/tests run test:quiz",
    "test:zhs": "npm --prefix extras/tests run test:zhs",
    "test:ykt": "npm --prefix extras/tests run test:ykt",
    "test:all": "npm --prefix extras/tests run test:all",
    "test:headed": "npm --prefix extras/tests run test:headed",
    "test:judge": "npm --prefix extras/tests run test:judge",
    "test:multi": "npm --prefix extras/tests run test:multi",
    "test:settings": "npm --prefix extras/tests run test:settings",
    "test:accuracy": "npm --prefix extras/tests run test:accuracy",
    "test:newver": "npm --prefix extras/tests run test:newver",
    "test:pause": "npm --prefix extras/tests run test:pause"
  }
}
